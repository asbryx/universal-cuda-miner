# Copy to .env locally; never commit the copy.
# Use synthetic or public endpoints for dry-run tests.
RPC_URLS=https://rpc.example.invalid/
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_ID=1
WALLET_KEYFILE=/path/to/local/wallet.keys
MAX_MINT_PRICE_WEI=100000000000000
MAX_TOTAL_MINT_WEI=5000000000000000
GAS_LIMIT=300000
MAX_GAS_PRICE_WEI=1000000000
# The second host starts at base offset 4 because each host has local GPUs 0..3.
# The worker adds its local GPU id; this keeps host lanes globally disjoint.
HOSTS=host-a:22:0,host-b:22:4
CUDA_BINARY=/path/to/hashbroker_cuda
SSH_USER=miner
SSH_KEYFILE=/path/to/local/ssh_key
